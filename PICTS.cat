      <rules>
        <rule name="War Tattoos" id="0596-fc9a-bd30-93fa" hidden="false">
          <description>Picts can re-roll a failed morale check.</description>
        </rule>
        <rule name="Javelin Masters" id="f2cf-4b4f-5eb6-36c5" hidden="false">
          <description>Picts ignore the long range penalty when shooting with javelins.</description>
        </rule>
        <rule name="Weather" id="d04b-bd97-5920-16bd" hidden="false">
          <description>Picts ignore the effects of heavy rain and fog.</description>
        </rule>
        <rule name="Castrum Raiders" id="aa15-fffe-427a-545d" hidden="false">
          <description>For each chieftain in your army, two of your warriors can be equipped with chainmail for free.</description>
        </rule>
        <rule name="Highland Guerrillas" id="ff0d-a751-c76a-c992" hidden="false">
          <description>Picts can’t be targeted by shooting attacks while within an area of rocky ground.


In addition, Picts ignore the difficult terrain penalty for moving through a rocky area of difficult terrain.</description>
        </rule>
      </rules>
    </forceEntry>
  </forceEntries>
