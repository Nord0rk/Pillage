      <rules>
        <rule name="Weather" id="48e1-2afc-f3ad-b6ca" hidden="false">
          <description>Visigoths aren’t affected by the effects of fog.</description>
        </rule>
        <rule name="Visigothic Banner" id="98b5-7906-292f-2a54" hidden="false">
          <description>Visigothic banners follow the same rules as ordinary banners (see the rulebook, p.79). 


However, they let you re-roll all failed to hit rolls, not just results of 1.</description>
        </rule>
        <rule name="Protect the Loot!" id="aea3-a878-147e-c693" hidden="false">
          <description>While a Visigoth figure with a loot marker (or in contact with a loot marker) is in contact with an enemy figure, it can re-roll all its failed defence rolls against melee attacks.</description>
        </rule>
      </rules>
